# ---------------------------------------------------------------------------
# RSSResume — exemple de configuration
# Copier ce fichier en `.env` puis remplacer les valeurs factices.
# Rappel : l'application lit les variables d'environnement du processus,
# elle ne charge pas `.env` automatiquement (voir README « Chargement »).
# ---------------------------------------------------------------------------

# --- FreshRSS (obligatoire) ------------------------------------------------
# URL racine de l'instance FreshRSS (sans /api/greader.php)
FRESHRSS_BASE_URL=https://freshrss.example.com
FRESHRSS_USERNAME=mon-utilisateur
# Mot de passe d'API FreshRSS (Profil > Mot de passe d'API), pas le mot de passe du compte
FRESHRSS_API_PASSWORD=changeme-api-password

# --- RSSResume (optionnel) -------------------------------------------------
# Catégories à traiter, séparées par des virgules. Vide = toutes les catégories.
# Les flux FreshRSS sans catégorie ne sont jamais traités.
RSSRESUME_CATEGORIES=Tech,News
# Catégories à ne jamais traiter (ex. la catégorie fourre-tout de FreshRSS)
RSSRESUME_EXCLUDED_CATEGORIES= Uncategorized
# Répertoire de sortie (un sous-répertoire yyyyMMdd est créé par journée ; défaut : output)
RSSRESUME_OUTPUT_DIR=output
# Langue des résumés (défaut : fr)
RSSRESUME_SUMMARY_LANGUAGE=fr
# Fuseau dans lequel une journée commence et finit (défaut : Europe/Paris). En UTC, un
# article publié à 1 h du matin à Paris en heure d'été tombe dans la veille — donc dans
# une journée déjà livrée, et dans aucun digest. Requiert le paquet `tzdata` sur les
# systèmes sans base de fuseaux (Windows) : voir requirements.txt.
RSSRESUME_TIMEZONE=Europe/Paris
# Plafond de caractères envoyés au résumeur, par article (défaut : 8000 ; 0 désactive).
# Coupé à la dernière phrase entière. Le scoring, lui, n'a jamais lu que 400 caractères.
# Ne pas descendre sous 6000 sans raison : c'est ce que `tools/cve.py` lit sur la page
# d'un avis, et c'est là que sont les versions touchées.
RSSRESUME_ARTICLE_CHAR_LIMIT=8000
# Score minimal (0-10) pour qu'un article entre dans le digest (défaut : 7)
# Le document de la personne : tout ce qui est personnel, dans un seul fichier hors du
# dépôt — `input/` est gitignoré. Trois clés, dont seule « profil » est exigée :
#   {
#     "profil": "Sage-femme libérale. Veille : santé publique, nomenclature, matériel.",
#     "stack":  ["Traefik", {"nom": "Keycloak", "alias": ["RH-SSO"]}],
#     "email":  "moi@example.com"
#   }
# - profil : le texte qui définit ce qui mérite d'être noté et raconté. Sans document, le
#   profil par défaut de rssresume/profil.py s'applique — il vaut pour quelqu'un dans la
#   tech et ne décrit personne. En changer renote automatiquement les articles.
# - stack : les composants dont un avis CERT-FR doit faire lever la tête (voir plus bas).
#   Une chaîne, ou un objet quand les avis emploient plusieurs écritures.
# - email : le ou les destinataires du digest. Cette clé remplace SMTP_TO, qui n'est plus
#   lue et fait désormais échouer le lancement si elle traîne encore dans l'environnement.
# Le fichier est lu comme un objet JSON s'il commence par une accolade, comme du texte brut
# sinon — les autres clés servent à l'annoter. Annoncé mais illisible, vide, au JSON cassé
# ou sans texte à la clé « profil », il fait échouer le lancement.
# RSSRESUME_PROFILE_FILE=input/moi/profile.json
# Le profil seul, sur une ligne, quand il n'y a ni stack ni destinataire à déclarer :
# RSSRESUME_PROFILE=Sage-femme libérale. Veille : santé publique, nomenclature, matériel.

RSSRESUME_SCORE_THRESHOLD=7
# Seuil propre à une catégorie, qui l'emporte sur le seuil général. Plusieurs entrées
# séparées par des virgules, sous la forme « Catégorie=score ». Une catégorie
# généraliste, où tout est intéressant à connaître sans être actionnable, se vide à 7 :
# elle se juge un cran plus bas.
# RSSRESUME_CATEGORY_THRESHOLDS=Tech generaliste=5, Veille marche=6
# Filet contre les journées creuses : en dessous de RSSRESUME_MIN_DIGEST_ITEMS articles
# retenus, le seuil de la catégorie tombe à RSSRESUME_FALLBACK_THRESHOLD pour la journée
# entière — tous les articles au-dessus entrent, dans la limite du plafond.
# Mettre RSSRESUME_MIN_DIGEST_ITEMS=0 pour désactiver le repli.
RSSRESUME_MIN_DIGEST_ITEMS=5
RSSRESUME_FALLBACK_THRESHOLD=5
# Nombre maximum d'articles retenus par catégorie (défaut : 12)
RSSRESUME_MAX_DIGEST_ITEMS=12

# --- Comment la journée s'écoute (optionnel) --------------------------------
# « category » (défaut) : un fichier audio par catégorie. Six catégories font six mp3,
# donc six ouvertures, six clôtures, et une manipulation de lecteur entre chaque.
# « global » : un seul fichier pour toute la journée. Les résumés de catégorie — déjà
# écrits, et inchangés — sont enchaînés en une seule prise de parole : une salutation qui
# vous nomme, l'éphéméride du jour, une phrase qui annonce ce qui vient, les catégories
# avec des transitions entre elles, et une conclusion sur ce qu'il y a à faire.
# Le montage réécrit les LIAISONS, pas les faits : identifiants de vulnérabilité, noms de
# produits et numéros de version sont recopiés à l'identique. L'email ne change pas — il
# montre toujours les résumés de chaque catégorie mot pour mot, avec leurs liens ; seule
# la pièce jointe diffère, un « journee.mp3 » unique. Le texte lu est conservé dans
# « journee.json », ce qui permet de le confronter aux résumés sans réécouter.
# Coût : un appel de complétion de plus par journée, et autant de caractères de synthèse
# qu'avant sur moins d'appels — sensiblement neutre. Il apparaît sous son propre poste.
# Une valeur inconnue fait échouer le lancement : une faute de frappe ignorée retomberait
# sur « category », c'est-à-dire précisément sur le mode que l'on voulait quitter.
# --audio-mode l'emporte sur cette variable, pour essayer l'autre mode sur une journée
# sans toucher à l'environnement du conteneur.
# La salutation vous nomme si la clé « prenom » du document de profil est remplie ;
# absente, le montage ouvre sans nommer personne. Elle n'a pas de variable à elle, pour
# la même raison que le destinataire : rien de personnel ne se déclare ici.
RSSRESUME_AUDIO_MODE=category

# --- Catégories traitées sans IA (optionnel) --------------------------------
# Catégories routées vers le traitement déterministe des avis CERT-FR, séparées par des
# virgules. Elles ne passent alors ni par le scoring, ni par le résumé, ni par la
# synthèse vocale : leurs avis sont appariés sur la liste des composants déclarée à la clé
# « stack » du document de profil, et rendus en une phrase qui nomme ce qui nous touche et
# à quel titre. Les autres avis sont marqués lus sans être résumés.
# Un flux d'avis publie cinq à dix articles par jour, tous sur le même moule : payer un
# résumé pour cela revient à faire reformuler un formulaire, et sept paragraphes qui
# commencent tous pareil sont exactement ce qu'on n'écoute pas.
# Le libellé est comparé sans tenir compte de la casse NI DES ACCENTS — le libellé réel
# en porte, et un copier-coller les perd volontiers en route. Une entrée écrite comme un
# seuil (« Catégorie=7 ») fait échouer le lancement : cette variable ne prend que des
# libellés. Vide = toutes les catégories passent par le pipeline habituel.
# RSSRESUME_CERTFR_CATEGORIES=1 - Alertes et avis CERT-FR ANSSI
# La liste des composants n'a pas de variable à elle : elle se déclare à la clé « stack »
# du document ci-dessus, avec le profil de pertinence. Ce que l'on exploite est aussi
# personnel que ce que l'on veut lire, et cela ne se publie pas plus.

# --- Exécution quotidienne en conteneur (rssresume.scheduler) -------------
# Heure du passage, dans RSSRESUME_TIMEZONE (défaut : 07:00). Ignoré par
# `python -m rssresume`, qui s'exécute immédiatement.
RSSRESUME_SCHEDULE=07:00
# Journée digérée, comptée depuis celle du passage (défaut : 1, la veille). Un passage
# à 7 h qui digérerait « aujourd'hui » ne lirait que les articles parus depuis minuit ;
# mettre 0 pour un passage du soir, qui raconte la journée qui s'achève.
RSSRESUME_SCHEDULE_DAYS_BACK=1

# --- Fournisseurs de LLM ---------------------------------------------------
# Ici, uniquement les secrets et le choix du fournisseur. Tout le reste — endpoints,
# modèles par action, voix, format audio, tarifs — vit dans rssresume/llm/providers.json,
# qui n'a pas à rester privé et se relit d'un coup d'œil.

# Les clés. Une par fournisseur, jamais empruntée : sans MISTRAL_API_KEY, une action
# confiée à Mistral retombe sur le local (résumé extractif, ou espeak pour la voix).
OPENAI_API_KEY=sk-remplacer-par-votre-cle
MISTRAL_API_KEY=remplacer-par-votre-cle-mistral

# Qui fait quoi. RSSRESUME_PROVIDER vaut pour tout (défaut : openai) ;
# RSSRESUME_<ACTION>_PROVIDER le surcharge pour une action seule.
# Actions : SCORING (notation), ARTICLE (résumé d'un article), DIGEST (résumé de
# catégorie), EPHEMERIDE (le fait du jour qui ouvre l'email), MONTAGE (l'audio d'une
# journée, en mode global seulement), TTS (synthèse vocale).
# EPHEMERIDE est un appel par JOURNÉE, pas par catégorie, et il n'est jamais bloquant :
# sans clé, ou si le modèle ne connaît rien à cette date, l'email ouvre sur la table
# embarquée de rssresume/ephemeride.py, puis sur le calendrier.
# MONTAGE est un appel par journée lui aussi, et pas davantage bloquant : sans clé ou
# après un échec, les résumés partent bout à bout, sans transitions ni conclusion, et
# journee.json l'écrit (« origine »: « assemblage »).
RSSRESUME_PROVIDER=openai
# Garder les résumés chez OpenAI, prendre la voix française de Mistral :
RSSRESUME_TTS_PROVIDER=mistral

# Surcharge de providers.json, fusionnée clé à clé : on n'y redéclare que ce qu'on change.
# Ex. {"openai": {"actions": {"digest": {"model": "gpt-4.1"}}}}
# RSSRESUME_PROVIDERS_FILE=providers.json

# Tarifs supplémentaires, fusionnés par-dessus les grilles de tous les fournisseurs. Un
# modèle sorti après la dernière mise à jour de providers.json n'est pas facturé de
# travers : il ressort « sans tarif », et le récapitulatif de fin d'exécution renonce à
# son total plutôt que d'en annoncer un amputé. C'est ici qu'on lui donne son prix sans
# toucher au paquet, le temps que la grille livrée le rattrape.
# Dollars par million de tokens, ou par million de caractères pour une voix facturée ainsi.
# RSSRESUME_PRICES={"gpt-5.6-luna": {"input": 1.25, "output": 10.0}, "voxtral-mini-tts-2604": {"characters": 16.0}}

# --- Envoi d'email (optionnel, ignoré avec --dry-run ou --no-email) --------
# Par où part le digest : « smtp » (défaut) ou « resend ». Beaucoup d'hébergeurs de VPS
# filtrent 25, 465 et 587 en sortie : la connexion SMTP expire alors sur un TimeoutError
# sans que rien ne soit mal réglé, et « resend » passe par le 443, qui sort toujours.
# Un test depuis le conteneur tranche en dix secondes :
#   python -c "import socket; socket.create_connection(('smtp.example.com',587),10)"
RSSRESUME_MAIL_TRANSPORT=smtp
# Requise par « resend » seulement. Resend n'accepte d'expéditeur que sur un domaine
# vérifié chez lui — donc un domaine qui résout, la vérification passant par le DNS.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM vaut pour les deux transports : l'expéditeur ne change pas de nature parce que
# le chemin change. Le reste des réglages SMTP ci-dessous ne sert qu'au transport « smtp ».
# Le DESTINATAIRE, lui, n'est plus ici : il se déclare à la clé « email » du document de
# profil, avec le reste de ce qui est personnel. SMTP_TO n'est plus lue, et fait échouer le
# lancement tant qu'elle traîne dans l'environnement — ignorée, elle laisserait croire à un
# destinataire configuré et le digest ne partirait plus sans que rien ne le dise.
# Sans SMTP_HOST, ou sans destinataire déclaré, aucun email n'est envoyé.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=digest@example.com
SMTP_PASSWORD=changeme-smtp-password
SMTP_FROM=digest@example.com
# STARTTLS sur le port 587 (défaut : true)
SMTP_USE_TLS=true
# SMTPS direct sur le port 465 — mettre à true et SMTP_USE_TLS à false
SMTP_USE_SSL=false
