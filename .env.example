# ---------------------------------------------------------------------------
# RSSResume — exemple de configuration
# Copier ce fichier en `.env` puis remplacer les valeurs factices.
# Rappel : l'application lit les variables d'environnement du processus,
# elle ne charge pas `.env` automatiquement (voir README « Chargement »).
# ---------------------------------------------------------------------------

# --- FreshRSS (obligatoire) ------------------------------------------------
# URL racine de l'instance FreshRSS (sans /api/greader.php)
FRESHRSS_BASE_URL=https://freshrss.example.com
FRESHRSS_USERNAME=mon-utilisateur
# Mot de passe d'API FreshRSS (Profil > Mot de passe d'API), pas le mot de passe du compte
FRESHRSS_API_PASSWORD=changeme-api-password

# --- RSSResume (optionnel) -------------------------------------------------
# Catégories à traiter, séparées par des virgules. Vide = toutes les catégories.
# Les flux FreshRSS sans catégorie ne sont jamais traités.
RSSRESUME_CATEGORIES=Tech,News
# Catégories à ne jamais traiter (ex. la catégorie fourre-tout de FreshRSS)
RSSRESUME_EXCLUDED_CATEGORIES= Uncategorized
# Répertoire de sortie (un sous-répertoire yyyyMMdd est créé par journée ; défaut : output)
RSSRESUME_OUTPUT_DIR=output
# Langue des résumés (défaut : fr)
RSSRESUME_SUMMARY_LANGUAGE=fr
# Score minimal (0-10) pour qu'un article entre dans le digest (défaut : 7)
# Profil de pertinence : le texte qui définit ce qui mérite d'être noté et raconté.
# Sans lui, le profil par défaut de rssresume/profil.py s'applique. Le texte directement,
# ou un fichier pour un profil long. Changer de profil renote automatiquement les articles.
# RSSRESUME_PROFILE=Sage-femme libérale. Veille : santé publique, nomenclature, matériel.
# RSSRESUME_PROFILE_FILE=profil.txt

RSSRESUME_SCORE_THRESHOLD=7
# Nombre maximum d'articles retenus par catégorie (défaut : 12)
RSSRESUME_MAX_DIGEST_ITEMS=12
# Tarifs des modèles pour le journal `<categorie>.log.json`, en dollars par million
# d'unités, fusionnés par-dessus la grille de rssresume/pricing.py. À renseigner pour
# tout modèle absent de cette grille : sans tarif, son coût est rendu à null plutôt
# qu'à zéro. `input`/`output` pour des tokens, `characters` pour une synthèse vocale
# facturée au caractère. Sur une seule ligne ; un JSON illisible est ignoré.
# RSSRESUME_PRICES={"gpt-5.6-luna": {"input": 1.25, "output": 10.00}}

# --- API compatible OpenAI (optionnel) -------------------------------------
# Si OPENAI_API_KEY est absent : résumés extractifs locaux + TTS via `espeak`.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-remplacer-par-votre-cle
# Résumé audio d'une catégorie
OPENAI_SUMMARY_MODEL=gpt-5.6-luna
# Notation des articles : tâche de classification, un petit modèle suffit
OPENAI_SCORING_MODEL=gpt-4o-mini
# Résumé par article — utilisé par summarize_top, hors pipeline quotidien
OPENAI_ARTICLE_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# Consignes de diction, pour les modèles qui les acceptent (gpt-4o-mini-tts et suivants).
# Sur une seule ligne ; `\n` y est rendu comme un saut de ligne, et les guillemets
# encadrants sont retirés. Vide, le paramètre n'est pas envoyé du tout.
# Le rythme se joue ici autant que dans le texte du résumé. Une consigne du genre « ton
# neutre, débit régulier » donne exactement ce qu'elle demande : une voix plate. Ce qui
# marche, c'est de nommer la situation d'écoute (une personne, en tête à tête), de
# demander explicitement la variation d'intonation, et de dicter la prononciation des
# sigles, des identifiants de CVE et des numéros de version.
# OPENAI_TTS_INSTRUCTIONS="""Langue : français de France, prononciation native, sans aucune trace d'accent anglophone.\nSituation : tu racontes à UNE personne, en tête à tête, ce que tu as lu ce matin. Ce n'est pas un journal télévisé, pas une annonce, pas une lecture à voix haute.\nTon : vivant et impliqué, celui d'un collègue de confiance. Reste factuel sur une faille critique, mais ne sois pas neutre au point d'être plat.\nRythme — c'est le point le plus important : ne récite pas. Fais varier l'intonation d'une phrase à la suivante, appuie le mot qui porte l'information, laisse la voix redescendre franchement sur les points. Deux phrases de suite ne doivent pas avoir la même mélodie.\nDébit : naturel et un peu allant sur les enchaînements ; ralentis nettement sur un identifiant, un numéro de version, un chiffre ou une date. Articule sans forcer.\nPauses : respire aux points, marque une pause franche au changement de sujet, une pause brève avant et après un numéro de version. La phrase d'ouverture et la phrase de fin sont détachées du reste par un silence net.\nSigles : détache les lettres — A.N.S.S.I., C.E.R.T.-F.R., R.G.P.D., C.V.E. Ne les lis jamais comme des mots.\nIdentifiants de vulnérabilité : lis CVE-2026-1234 « C.V.E. deux mille vingt-six, mille deux cent trente-quatre », sans dire « tiret ».\nNuméros de version : lis 7.4.5 « sept point quatre point cinq », chiffre par chiffre, posément.\nNoms de produits et de sociétés anglophones : prononciation anglaise ; tout le reste en français.\nN'ajoute rien au texte, ne commente pas, ne t'annonce pas."""

# --- Envoi d'email (optionnel, ignoré avec --dry-run ou --no-email) --------
# Sans SMTP_HOST / SMTP_TO, aucun email n'est envoyé.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=digest@example.com
SMTP_PASSWORD=changeme-smtp-password
SMTP_FROM=digest@example.com
# Destinataires séparés par des virgules
SMTP_TO=dest@example.com
# STARTTLS sur le port 587 (défaut : true)
SMTP_USE_TLS=true
# SMTPS direct sur le port 465 — mettre à true et SMTP_USE_TLS à false
SMTP_USE_SSL=false
