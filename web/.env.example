# Site d'administration RSSResume — copier en .env.local pour le développement.
# En déploiement, ces variables se saisissent dans l'onglet « Environment » de Dokploy.

# L'API de l'appli de résumé. En compose, le service `api` : http://api:8080.
# En développement, la fausse API de `npm run mock` : http://localhost:8080.
RSSRESUME_API_URL=http://api:8080
# Le jeton Bearer partagé avec l'appli de résumé. Il ne quitte jamais le serveur du site.
# `npm run mock` accepte « dev ».
RSSRESUME_API_TOKEN=dev

# L'administrateur : prévenu de chaque inscription, et administrateur du site quand un
# compte porte cette adresse. Créer ce compte dès le premier déploiement.
ADMIN_EMAIL=admin@example.com

# L'alerte d'inscription, par l'API HTTP de Resend. Sans clé, l'inscription fonctionne et
# l'alerte est seulement écrite dans les journaux du conteneur.
RESEND_API_KEY=
# Un expéditeur sur un domaine vérifié chez Resend.
MAIL_FROM=RSSResume <rssresume@example.com>

# L'adresse publique du site, sans « / » final. Exigée par adapter-node derrière un proxy :
# c'est contre elle que SvelteKit vérifie l'en-tête Origin des formulaires (CSRF).
ORIGIN=http://localhost:5173

# Le fichier SQLite des comptes. Dans l'image : /data-web/comptes.sqlite, sur un volume.
DATABASE_PATH=data/comptes.sqlite

# Derrière Traefik (Dokploy), l'IP du client est dans X-Forwarded-For : sans ces deux
# lignes, toutes les tentatives de connexion semblent venir du proxy et partagent une
# seule limite. XFF_DEPTH = le nombre de proxys de confiance devant le site.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
