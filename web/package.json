{
	"name": "rssresume-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.17",
		"npm": ">=11.19.1"
	},
    "packageManager": "npm@11.19.1",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --disable-warning=ExperimentalWarning build",
		"mock": "node mock/api-resume.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@node-rs/argon2": "2.2.2"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "6.0.5",
		"@sveltejs/kit": "3.4.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "24.19.2",
		"svelte": "5.58.0",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"vite": "8.3.8",
		"vitest": "5.1.1"
	}
}
